<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_bringup</name>
  <version>0.0.1</version>
  <description>Combined camera and Unitree LiDAR bringup.</description>
  <maintainer email="sehajthewarrior@gmail.com">sehaj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>depthai_ros_driver_v3</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mobile_nav_bringup</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>unitree_lidar_ros2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
